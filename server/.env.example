# Port d'écoute du serveur backend Stremo
PORT=3001

# Clé d'accès optionnelle (fortement recommandée en cas d'exposition via Cloudflare Tunnel ou accès public)
# Si définie, les requêtes API nécessitent l'en-tête 'x-stremo-key' ou la saisie du code dans l'interface.
STREMO_ACCESS_KEY=votre_cle_secrete_ici

# Chemins optionnels vers les binaires ffmpeg et ffprobe (si non présents dans le PATH système)
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
