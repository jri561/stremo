{
  "packageId": "com.stremo.app",
  "host": "stremo.app",
  "name": "Stremo",
  "launcherName": "Stremo",
  "themeColor": "#07090e",
  "navigationColor": "#07090e",
  "backgroundColor": "#07090e",
  "startUrl": "/",
  "iconUrl": "/icon-512.png",
  "maskableIconUrl": "/icon-maskable-512.png",
  "appVersionName": "1.0.0",
  "appVersionCode": 1,
  "signingKey": {
    "path": "./android.keystore",
    "alias": "android"
  },
  "enableNotifications": true,
  "features": {
    "locationDelegation": {
      "enabled": false
    },
    "playBilling": {
      "enabled": false
    }
  },
  "alphaDependencies": {
    "enabled": false
  },
  "enableSiteSettingsShortcut": true,
  "isChromeOSOnly": false,
  "isAndroidTV": true
}
