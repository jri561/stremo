<resources>
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">#6366f1</item>
        <item name="colorPrimaryDark">#07090e</item>
        <item name="colorAccent">#818cf8</item>
        <item name="android:windowBackground">#07090e</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">#07090e</item>
        <item name="android:windowBackground">#07090e</item>
        <item name="android:statusBarColor">#07090e</item>
        <item name="android:navigationBarColor">#07090e</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="AppTheme.NoActionBar">
        <item name="android:windowBackground">#07090e</item>
    </style>
</resources>
